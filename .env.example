# ==============================================================================
# 1127 Events — environment
# ==============================================================================
# Copy to .env.local for local development, and set the same names in the
# Amplify console (App settings → Environment variables) for the deployed app.
#
# With NONE of these set, `npm run dev` still works: events and submissions are
# stored in .data/ and the dashboard uses a local development sign-in.
# ==============================================================================

# --- Data (from the CloudFormation stack outputs) -----------------------------
# EVENTS_TABLE=1127-events-events
# SUBMISSIONS_TABLE=1127-events-submissions

# Amplify blocks variables starting with AWS_, so set the region here.
# In Lambda, AWS_REGION is injected automatically and used as a fallback.
# APP_AWS_REGION=us-west-2

# --- Admin sign-in (from the CloudFormation stack outputs) --------------------
# COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- RSVP email (Amazon SES) --------------------------------------------------
# With none of these set, no email is sent and RSVPs are still recorded.
#
# Sender. Must be an address on the SES-verified domain. Setting this alone
# enables email; the display name is optional but recommended.
# SES_FROM_ADDRESS="Sun Club <hello@1127.events>"

# Where replies go. Defaults to the from address.
# SES_REPLY_TO=hello@1127.events

# Who gets an internal "new RSVP" alert. Comma separated. Omit for none.
# RSVP_NOTIFY_ADDRESS=you@1127.events,partner@1127.events

# From the stack output EmailConfigurationSetName — enables bounce/complaint
# suppression and reputation metrics.
# SES_CONFIGURATION_SET=1127-events-email

# Signs unsubscribe links. REQUIRED before guest email will send: without a
# real value the links would be forgeable, so confirmations stay paused.
# Generate one with:  openssl rand -base64 32
# APP_SECRET=

# Absolute base URL used for links inside emails. Defaults to brand.domain.
# SITE_URL=https://1127.events

# --- Text messages (AWS End User Messaging) -----------------------------------
# Requires a provisioned number AND completed A2P registration. See DEPLOY.md.
# Nothing sends unless BOTH of the first two are set.
# SMS_ORIGINATION_IDENTITY=arn:aws:sms-voice:us-west-2:123456789012:phone-number/abc
# SMS_OPT_OUT_LIST=1127-opt-outs
# SMS_CONFIGURATION_SET=1127-events-sms

# --- Local development sign-in ------------------------------------------------
# Only active when the Cognito variables above are absent AND NODE_ENV is not
# "production". Ignored entirely in a deployed build.
# DEV_ADMIN_EMAIL=admin@1127.local
# DEV_ADMIN_PASSWORD=1127-dev
# DEV_ADMIN_SECRET=change-me-locally
